{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.novel-analysis/schemas/cross_book_pattern.schema.json",
  "title": "Cross-book Transferable Pattern",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pattern_id", "name", "mechanism", "applicable_contexts", "source_books", "variations", "failure_modes", "originality_constraints", "confidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pattern_id": {"type": "string", "pattern": "^PAT-[0-9]{5}$"},
    "name": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "applicable_contexts": {"type": "array", "items": {"type": "string"}},
    "source_books": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["book_id", "evidence_refs"],
        "properties": {
          "book_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "variations": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "originality_constraints": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
