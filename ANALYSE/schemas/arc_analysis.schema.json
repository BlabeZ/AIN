{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.novel-analysis/schemas/arc_analysis.schema.json",
  "title": "Narrative Arc Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "book_id", "arc_id", "level", "start_chapter", "end_chapter", "problem", "stages", "drivers", "payoffs", "new_questions", "craft_hypotheses"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "book_id": {"type": "string"},
    "arc_id": {"type": "string", "pattern": "^ARC-[A-Z]-[0-9]{4}$"},
    "level": {"enum": ["micro", "medium", "long"]},
    "parent_arc_ids": {"type": "array", "items": {"type": "string"}},
    "thread_ids": {"type": "array", "items": {"type": "string"}},
    "start_chapter": {"type": "integer", "minimum": 0},
    "end_chapter": {"type": "integer", "minimum": 0},
    "problem": {"type": "string", "minLength": 1},
    "starting_state": {"type": "string"},
    "ending_state": {"type": "string"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "chapter_range", "function", "source_fact_ids"],
        "properties": {
          "name": {"type": "string"},
          "chapter_range": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},
          "function": {"type": "string"},
          "source_fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "drivers": {"type": "array", "items": {"type": "string"}},
    "payoffs": {"type": "array", "items": {"type": "string"}},
    "new_questions": {"type": "array", "items": {"type": "string"}},
    "craft_hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim", "evidence", "alternative_explanation", "confidence"],
        "properties": {
          "claim": {"type": "string"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^C[0-9]{6}-(E|I|S|L)[0-9]{3}$"
            }
          },
          "alternative_explanation": {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    }
  }
}
