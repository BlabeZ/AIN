{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.novel-analysis/schemas/ledger_event.schema.json",
  "title": "State, Thread, or Clue Ledger Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "book_id", "ledger_type", "event_id", "chapter_id", "operation", "subject_id", "payload", "source_fact_ids", "confidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "book_id": {"type": "string"},
    "ledger_type": {"enum": ["state", "thread", "clue"]},
    "event_id": {"type": "string"},
    "chapter_id": {"type": "integer", "minimum": 0},
    "operation": {"enum": ["open", "update", "strengthen", "partially_resolve", "resolve", "invalidate", "checkpoint"]},
    "subject_id": {"type": "string"},
    "payload": {"type": "object"},
    "source_fact_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
